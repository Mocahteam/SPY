      value: Text (TMP)
      objectReference: {fileID: 0}
    - target: {fileID: 8944559683275527400, guid: 4fdcd5065fbff574d8a0a77b388b5583,
        type: 3}
      propertyPath: m_text
      value: "C'\xE9tait tout simplement <sprite name=\"Amazing\">, plus qu'a entrer
        dans la <color=#FF0000><sprite name=\"GreenRoom\"></color>, ce n'est pas
        une <sprite name=\"BreakingNews\"> c'est juste pour faire monter le <sprite
        name=\"FunOMeter\">, n'est ce pas <sprite name=\"lovely\"> ?\n\nVoila ce
        que tu peut faire, utiliser donc la commande <Forward>  puis ensuite avec
        les commandes <TurnLeft> et <TurnRight> tu atteindra la fin !\n\nMaintenant
        que tu as interagi avec l'interface, il est temps d'ex\xE9cuter ton programme
        pour voir o\xF9 Erty s'arr\xEAte.\n\nLance l'ex\xE9cution en cliquant sur
        le bouton \"Ex\xE9cuter\". Observe ensuite la position finale d'Erty et dis-toi
        : est\n-ce qu'il a atteint la pi\xE8ce ? Si non, combien de cases lui reste-t-il
        \xE0 parcourir ?\n\nCombien de *chien* faut il ? <b>cc</b>"
      objectReference: {fileID: 0}
    - target: {fileID: 8944559683275527400, guid: 4fdcd5065fbff574d8a0a77b388b5583,
        type: 3}
      propertyPath: m_margin.y
      value: 14.826294
      objectReference: {fileID: 0}
    - target: {fileID: 8944559683275527400, guid: 4fdcd5065fbff574d8a0a77b388b5583,
        type: 3}
      propertyPath: m_HorizontalAlignment
      value: 1
      objectReference: {fileID: 0}
